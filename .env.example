# ── Discord ─────────────────────────────────────────────────────────────────
# Bot token and application id from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands on a single server for instant updates while developing.
# DISCORD_DEV_GUILD_ID=
# Comma-separated ids of servers hosting team logo emojis (the bot needs "Manage Expressions" there).
EMOJI_GUILD_IDS=

# ── Leaguepedia ─────────────────────────────────────────────────────────────
# Bot Password from https://lol.fandom.com/wiki/Special:BotPasswords (grant: Cargo),
# on an account with a confirmed email. Format: "AccountName@BotName".
LEAGUEPEDIA_BOT_USER=
LEAGUEPEDIA_BOT_PASSWORD=
# Contact appended to the User-Agent (repository URL or email).
LEAGUEPEDIA_CONTACT=https://github.com/your-name/pronobot
# Minimum delay between two Leaguepedia requests, in milliseconds.
LEAGUEPEDIA_MIN_INTERVAL_MS=8000

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=pronobot
POSTGRES_USER=pronobot
POSTGRES_PASSWORD=change-me
# Used when running the bot outside docker compose (compose builds it from the values above).
DATABASE_URL=postgres://pronobot:change-me@localhost:5432/pronobot

# ── Runtime ─────────────────────────────────────────────────────────────────
# development enables pretty logs.
NODE_ENV=production
LOG_LEVEL=info
HEALTH_PORT=3000

# ── Alerts ──────────────────────────────────────────────────────────────────
# Discord webhook (Channel settings → Integrations → Webhooks) receiving errors, failing health checks,
# restarts and failed backups. Leave empty to disable.
ALERT_WEBHOOK_URL=
# Optional: Discord user id pinged on errors.
ALERT_MENTION_USER_ID=

# ── Backups (scripts/backup.sh, run on the host) ────────────────────────────
# Where dumps are kept (relative to the project directory or absolute).
BACKUP_DIR=backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Optional off-site copy: an rsync destination (e.g. user@nas:/srv/backups/pronobot) …
BACKUP_RSYNC_TARGET=
# … and/or a restic repository (password read from RESTIC_PASSWORD_FILE).
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
